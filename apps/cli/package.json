{
  "name": "codex-to-poke",
  "version": "0.1.3",
  "description": "Unofficial local Poke to Codex bridge.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NienteSpigotSenzaJava/pokedex.git",
