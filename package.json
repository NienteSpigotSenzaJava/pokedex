{
  "name": "pokedex",
  "version": "0.1.0",
  "description": "Local Poke to Codex bridge for the Pokedex recipe.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm --workspace @pokedex/cli run build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint -f stylish",
    "lint:fix": "eslint --fix -f stylish",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.8"
  }
}
